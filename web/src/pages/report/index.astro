---
// 검증 리포트 (초안). 숫자는 빌드할 때 data/eval/results/의 결과 파일에서 직접 읽어요(손으로 옮기지 않아요).
import { execSync } from 'node:child_process';
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import ShowcaseLayout from '../../layouts/ShowcaseLayout.astro';
import { withBase } from '../../lib/url';

const RESULTS = resolve(process.cwd(), '..', 'data', 'eval', 'results');
const load = (f: string) => JSON.parse(readFileSync(resolve(RESULTS, f), 'utf-8'));

// 결과 파일 (모두 번역 프롬프트 v1, blind는 정답·근거 검수 후 결과)
const R = {
	v1: load('2026-10-25_qa_v1.json'),
	blind: load('2026-10-25_qa_blind_reviewed.json'),
	v1Dense: load('2026-10-28_qa_v1_dense_translate.json'),
	blindDense: load('2026-10-28_qa_blind_dense_translate.json'),
	v1Hyb: load('2026-11-01_qa_v1_hybrid_variants.json'),
	blindHyb: load('2026-11-01_qa_blind_hybrid_variants.json'),
	// 번역 프롬프트 v1 → v2 비교는 같은 근거로 잰 쌍끼리 봐요(blind는 검수 전 근거).
	v1Bm25V1: load('2026-10-25_qa_v1.json'),
	v1Bm25V2: load('2026-10-25_qa_v1_termmap.json'),
	blindBm25V1: load('2026-10-25_qa_blind.json'),
	blindBm25V2: load('2026-10-25_qa_blind_termmap.json'),
};

let commit = 'unknown';
try {
	commit = execSync('git rev-parse --short HEAD', { encoding: 'utf-8' }).trim();
} catch {}

const CH = ['section', 'w300o50', 'w500o100'] as const;
const SETS = [
	{ key: 'qa_v1', label: 'qa_v1', run: R.v1, dense: R.v1Dense, hyb: R.v1Hyb, b1: R.v1Bm25V1, b2: R.v1Bm25V2 },
	{ key: 'blind', label: 'blind', run: R.blind, dense: R.blindDense, hyb: R.blindHyb, b1: R.blindBm25V1, b2: R.blindBm25V2 },
];
const f3 = (x: number) => x.toFixed(3);
const pp = (n: number) => ((1 / n) * 100).toFixed(1);

// 주장이 그 칸에서 유지되는지: 더 높으면 ✅, 낮으면 ❌, 같으면 △
const mark = (a: number, b: number) => (a > b + 1e-9 ? '✅' : a < b - 1e-9 ? '❌' : '△');

// 표 A: 열 = 평가셋 × 청킹
const cells = SETS.flatMap((s) => CH.map((c) => ({ s, c })));
type Row = { claim: string; cell: (s: (typeof SETS)[number], c: string) => { m: string; why: string } };
const rowsA: Row[] = [
	{
		claim: 'BM25가 dense보다 낫다',
		cell: (s, c) => {
			const bm = s.run.recall_at_5[`${c}/bm25`], de = s.run.recall_at_5[`${c}/dense`];
			return { m: mark(bm, de), why: `BM25 ${f3(bm)} · dense ${f3(de)}` };
		},
	},
	{
		claim: '하이브리드가 가장 낫다',
		cell: (s, c) => {
			const h = s.hyb.recall_at_5[c].c;
			const singles = { 'dense(한)': s.run.recall_at_5[`${c}/dense`], 'dense(번역)': s.dense.recall_at_5[c].en, BM25: s.run.recall_at_5[`${c}/bm25`] };
			const [bestName, best] = Object.entries(singles).sort((x, y) => y[1] - x[1])[0];
			return { m: mark(h, best), why: `(c) ${f3(h)} · 단독 최고 ${bestName} ${f3(best)}` };
		},
	},
	{
		claim: '번역은 dense에 도움이 된다',
		cell: (s, c) => {
			const ko = s.dense.recall_at_5[c].ko, en = s.dense.recall_at_5[c].en;
			const lost = s.dense.changed[c].lost_with_translation.length;
			return { m: mark(en, ko), why: `${f3(ko)} → ${f3(en)}${lost ? ` (잃은 문항 ${lost})` : ''}` };
		},
	},
	{
		claim: '용어 매핑(v2)이 번역을 개선한다',
		cell: (s, c) => {
			const a = s.b1.recall_at_5[`${c}/bm25`], b = s.b2.recall_at_5[`${c}/bm25`];
			return { m: mark(b, a), why: `BM25 v1 ${f3(a)} → v2 ${f3(b)}` };
		},
	},
];

// 표 B: "w500o100이 가장 나은 청킹이다" — 열 = 평가셋 × 검색기
const retrievers = [
	{ label: 'dense(한)', get: (s: (typeof SETS)[number], c: string) => s.run.recall_at_5[`${c}/dense`] },
	{ label: 'BM25', get: (s: (typeof SETS)[number], c: string) => s.run.recall_at_5[`${c}/bm25`] },
	{ label: '하이브리드 (c)', get: (s: (typeof SETS)[number], c: string) => s.hyb.recall_at_5[c].c },
];
const chunkCell = (s: (typeof SETS)[number], r: (typeof retrievers)[number]) => {
	const w5 = r.get(s, 'w500o100');
	const others = Math.max(r.get(s, 'section'), r.get(s, 'w300o50'));
	return { m: mark(w5, others), why: CH.map((c) => `${c} ${f3(r.get(s, c))}`).join(' · ') };
};

const variantLabels: Record<string, string> = {
	a: '(a) dense(한) + BM25 — D-019',
	b: '(b) dense(번역) + BM25',
	c: '(c) dense(한) + dense(번역) + BM25 — D-020',
	d: '(d) dense(번역) 단독',
};
---

<ShowcaseLayout title="검증 리포트" description="FabAtlas 검색 설정을 여러 축에서 비교한 검증 리포트(초안)">
	<section>
		<h1>검증 리포트</h1>
		<p class="notice">초안 · 2026-11-01 · 커밋 <code>{commit}</code></p>
		<nav class="toc" aria-label="목차">
			<a href="#summary">요약</a> · <a href="#setup">실험 설정</a> · <a href="#axes">축별 결과</a> ·
			<a href="#breakdown">어디서 무너지나</a> · <a href="#failures">실패 사례</a> · <a href="#limits">한계와 다음 단계</a>
		</nav>
	</section>

	<section id="summary">
		<h2>1. 요약</h2>
		<p>
			근거를 보고 쓴 질문(qa_v1)에서는 BM25가 dense보다 높았지만, 근거를 보지 않고 쓴 질문(blind)에서는 세 청킹 모두 순서가 뒤집혔어요.
			그래서 한 설정의 점수가 아니라 "축을 바꿔도 유지되는가"를 보고 기본값을 골랐어요(청킹 w500o100, D-018 / 하이브리드 (c), D-020).
			고른 설정의 점수는 선택에 쓴 값이라 검증 점수가 아니에요. 검증은 새 test 질문으로 한 번 더 해요.
		</p>
	</section>

	<section id="setup">
		<h2>2. 실험 설정</h2>
		<ul>
			<li>코퍼스: 영어 위키백과 23개 문서(CC BY-SA 4.0). 문서별 출처와 판 번호는 <a href="https://github.com/Kyoo32/fab-atlas/blob/main/data/sources.csv">sources.csv</a>에 있어요.</li>
			<li>평가셋: qa_v1 50문항(근거 있는 {R.v1.n_items}개), blind 30문항(근거 있는 {R.blind.n_items}개). 1문항 = {pp(R.v1.n_items)}%p / {pp(R.blind.n_items)}%p<sup>1</sup></li>
			<li>지표: Recall@5 — 상위 5개 청크 중 하나라도 정답 근거의 글자 범위와 겹치면 맞힘이에요.</li>
			<li>축: 청킹 3종(section, w300o50, w500o100) × 검색기(dense 한국어, dense 번역, BM25 번역, 하이브리드 a/b/c) × 평가셋 2종, 번역 프롬프트 v1/v2</li>
			<li>임베딩 {R.v1.config.embedding.split('@')[0]}, 번역 {R.v1.config.translate_model}, RRF k = {R.v1.config.rrf_k}</li>
		</ul>
	</section>

	<section id="axes">
		<h2>3. 축별 결과</h2>
		<h3>9조합 (qa_v1과 blind를 나란히, D-015)</h3>
		<div class="table-wrap">
			<table>
				<thead>
					<tr><th rowspan="2">청킹</th><th colspan="3">qa_v1 (근거를 보고 쓴 질문)</th><th colspan="3">blind (근거를 보지 않고 쓴 질문)</th></tr>
					<tr><th>dense(한)</th><th>BM25</th><th>하이브리드 (a)</th><th>dense(한)</th><th>BM25</th><th>하이브리드 (a)</th></tr>
				</thead>
				<tbody>
					{CH.map((c) => (
						<tr>
							<td>{c}</td>
							{SETS.flatMap((s) => ['dense', 'bm25', 'hybrid'].map((r) => <td>{f3(s.run.recall_at_5[`${c}/${r}`])}</td>))}
						</tr>
					))}
				</tbody>
			</table>
		</div>

		<h3>하이브리드 변형 (RRF k = 60)</h3>
		<div class="table-wrap">
			<table>
				<thead>
					<tr><th>조합</th>{SETS.flatMap((s) => CH.map((c) => <th>{s.label}<br />{c}</th>))}</tr>
				</thead>
				<tbody>
					{Object.entries(variantLabels).map(([k, label]) => (
						<tr>
							<td>{label}</td>
							{SETS.flatMap((s) => CH.map((c) => <td>{f3(s.hyb.recall_at_5[c][k])}</td>))}
						</tr>
					))}
				</tbody>
			</table>
		</div>
	</section>

	<section id="breakdown">
		<h2>4. 어디서 무너지나</h2>
		<p class="small">✅ 주장대로(더 높음) · ❌ 반대(더 낮음) · △ 같음. 칸마다 근거 숫자를 함께 적었어요.<sup>2</sup></p>
		<div class="table-wrap">
			<table class="claims">
				<thead>
					<tr><th>주장</th>{cells.map(({ s, c }) => <th>{s.label}<br />{c}</th>)}</tr>
				</thead>
				<tbody>
					{rowsA.map((row) => (
						<tr>
							<td>{row.claim}</td>
							{cells.map(({ s, c }) => {
								const { m, why } = row.cell(s, c);
								return <td><span class="mark">{m}</span><br /><span class="why">{why}</span></td>;
							})}
						</tr>
					))}
				</tbody>
			</table>
		</div>
		<div class="table-wrap">
			<table class="claims">
				<thead>
					<tr><th>주장</th>{SETS.flatMap((s) => retrievers.map((r) => <th>{s.label}<br />{r.label}</th>))}</tr>
				</thead>
				<tbody>
					<tr>
						<td>w500o100이 가장 나은 청킹이다</td>
						{SETS.flatMap((s) => retrievers.map((r) => {
							const { m, why } = chunkCell(s, r);
							return <td><span class="mark">{m}</span><br /><span class="why">{why}</span></td>;
						}))}
					</tr>
				</tbody>
			</table>
		</div>
		<ul class="small">
			<li>"BM25가 dense보다 낫다"는 평가셋 축 하나에서 통째로 무너졌어요. 질문을 근거를 보며 쓰면 번역 질의가 원문 단어와 겹쳐(내용어 겹침 qa_v1 평균 50%, blind 32%) BM25가 유리해져요.</li>
			<li>"하이브리드가 가장 낫다"는 blind section에서 무너졌어요. 하이브리드 셋 다 0.542였고 dense(번역) 단독이 0.667이었어요. BM25가 낮은 칸에서는 합친 결과도 끌려 내려가요.</li>
			<li>"번역은 dense에 도움이 된다"는 여섯 칸 모두 올랐지만, blind에서는 조합마다 1~3문항을 잃었어요. 평균이 오른다고 모든 문항이 나아지는 건 아니에요.</li>
			<li>"용어 매핑(v2)"은 칸마다 방향이 달라 개선이라고 볼 근거가 없어서 v1로 되돌렸어요(D-017). w500o100은 qa_v1에서 dense·하이브리드 기준으로 1등이 아니었지만 blind에서는 세 검색기 모두 1등이라, 편향이 적은 blind를 우선해 골랐어요(D-018).</li>
		</ul>
	</section>

	<section id="failures">
		<h2>5. 실패 사례</h2>
		<p class="small">w500o100에서 dense(한국어)가 놓친 qa_v1 문항 10개 중 원인이 다른 두 개예요. 원인은 아직 후보예요.</p>
		<div class="table-wrap">
			<table>
				<thead><tr><th>문항</th><th>정답 근거</th><th>dense(한)가 대신 가져온 청크</th><th>다른 검색기</th><th>원인 후보</th></tr></thead>
				<tbody>
					<tr>
						<td><b>E003</b> EUV 광원에서 주석 찌꺼기가 집광 거울에 쌓이는 문제는 어떻게 해결하나요?</td>
						<td>S008§3 EUV lithography — Laser-produced plasma (LPP)</td>
						<td>S008§7 Tool uptime, S008§8 Tool, S008§20 Resist erosion, S008§19 Tin redeposition, S008§22 Pellicles</td>
						<td>dense(번역) {R.v1Dense.per_item.E003.w500o100.en.first_rank}위, BM25 {R.v1.per_item.E003['w500o100/bm25'].first_rank}위, 하이브리드 (c) {R.v1Hyb.per_item.E003.w500o100.c.first_rank}위</td>
						<td>문서는 맞게 찾았지만, 10,550단어짜리 긴 문서 안에서 주석 오염을 다루는 다른 섹션들과 구분하지 못했어요.</td>
					</tr>
					<tr>
						<td><b>E004</b> 감광액을 스핀 코팅으로 바르면 표면이 어떻게 평평해지나요?</td>
						<td>S006§4 Photolithography — Photoresist application 구간</td>
						<td>S003§3·§1 Chemical-mechanical polishing, S021§2 Flip chip, S008§16, S023§1 Die singulation</td>
						<td>dense(번역) 상위 5개 밖, BM25 {R.v1.per_item.E004['w500o100/bm25'].first_rank}위, 하이브리드 (c) {R.v1Hyb.per_item.E004.w500o100.c.first_rank}위</td>
						<td>"평평해진다"는 뜻이 평탄화(CMP) 문서 쪽으로 끌렸어요. "spin coating" 같은 고유 단어는 BM25가 더 잘 잡아요.</td>
					</tr>
				</tbody>
			</table>
		</div>
		<h3>답변 실패: 과잉 거절</h3>
		<p>
			"EDS 공정에서는 무엇을 검사하나요?" — 검색은 정답 문서 S018(Wafer testing)을 상위 5개 중 3위로 찾았지만, 근거에 "EDS"라는 단어가 없어
			답변이 거절했어요(과잉 거절, D-010). EDS는 국내 업계 용어이고 영어 위키백과는 Wafer testing이라고 불러요.
			<a href={withBase('demo/')}>데모에서 응답 보기 →</a>
		</p>
	</section>

	<section id="limits">
		<h2>6. 한계와 다음 단계</h2>
		<ul>
			<li>문항 수가 적어요. 1문항이 qa_v1 {pp(R.v1.n_items)}%p, blind {pp(R.blind.n_items)}%p라 1~2문항 차이는 우열로 보기 어려워요.</li>
			<li>blind를 설정 선택에 여러 번 썼어요(청킹, 검색기, 하이브리드 변형). 그래서 blind 점수도 검증 점수가 아니에요.</li>
			<li>번역 흔들림을 재지 않았어요. 같은 프롬프트·온도 0에서도 번역 문장이 바뀐 사례(B018)가 있어요.</li>
			<li>section 청크 6개가 임베딩 입력 한도 1,024토큰을 넘어 뒷부분이 잘렸어요. section 결과에 이 영향이 섞였을 수 있어요.</li>
			<li>다음: 설정 선택에 쓰지 않은 새 test 질문 10~20개를 근거를 보지 않고 쓰고, w500o100 + 하이브리드 (c)로 한 번만 재요. 과잉 거절(EDS)을 개선할지도 그때 정해요.</li>
		</ul>
		<p>
			이 방식은 대학원에서 시계열 인과추론 결과를 검증할 때 쓴 다축 강건성 검증(MARC)을 RAG 검색에 옮긴 거예요.
			그때는 "이 인과 관계가 있다"는 주장이 분석 설계를 바꿔도 유지되는지 봤고, 여기서는 "이 검색 설정이 낫다"는 주장이 평가셋·청킹·검색기·번역을 바꿔도 유지되는지 봐요.
			축을 바꿔도 남는 주장만 결론으로 쓰고, 무너지는 칸은 실패 사례로 따로 기록해요.
		</p>
	</section>

	<section class="footnotes">
		<h2>각주</h2>
		<ol class="small">
			<li>1문항 = 1 / 근거 있는 문항 수 × 100. qa_v1 1/{R.v1.n_items}, blind 1/{R.blind.n_items}.</li>
			<li>
				숫자는 data/eval/results/의 결과 파일을 빌드할 때 읽어요. 9조합·dense(한)·BM25는 2026-10-25_qa_v1.json과 2026-10-25_qa_blind_reviewed.json(검수 후),
				dense(번역)은 2026-10-28_*_dense_translate.json, 하이브리드 변형은 2026-11-01_*_hybrid_variants.json이에요.
				"하이브리드가 가장 낫다"는 하이브리드 (c)와 단독 검색기 셋(dense 한, dense 번역, BM25) 중 가장 높은 값을 비교했어요.
				"용어 매핑(v2)"은 같은 근거로 잰 쌍끼리 비교해서, blind는 검수 전 근거로 잰 2026-10-25_qa_blind.json과 _termmap.json을 썼어요.
			</li>
		</ol>
	</section>

	<p><a href={withBase('notes/')}>작업노트에서 진행 과정 보기 →</a></p>
</ShowcaseLayout>

<style>
	h1 { margin: 0 0 8px; }
	h3 { font-size: 1rem; margin: 20px 0 8px; }
	.notice { background: var(--card); border: 1px solid var(--line); border-radius: 8px; padding: 12px 16px; }
	.toc { font-size: 0.9rem; margin-top: 12px; }
	.small { color: var(--muted); font-size: 0.85rem; }
	.table-wrap { overflow-x: auto; margin: 8px 0 16px; }
