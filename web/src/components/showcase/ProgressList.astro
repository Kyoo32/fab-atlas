---
// src/data/progress.json을 읽어 체크리스트로 보여줘요. /devlog가 done 값을 갱신해요.
import progress from '../../data/progress.json';

const total = progress.phases.flatMap((p) => p.items).length;
const done = progress.phases.flatMap((p) => p.items).filter((i) => i.done).length;
---

<p class="meta">{done} / {total} 완료 · {progress.updated} 기준</p>
<div class="phases">
	{progress.phases.map((phase) => (
		<div class="phase">
			<h3>{phase.label}</h3>
			<ul>
				{phase.items.map((item) => (
					<li class={item.done ? 'done' : ''}>
						<span class="box" aria-hidden="true">{item.done ? '✓' : ''}</span>
						<span>{item.text}</span>
						<span class="sr-only">{item.done ? '(완료)' : '(진행 전)'}</span>
					</li>
				))}
			</ul>
		</div>
	))}
</div>

<style>
	.meta { color: var(--muted); margin: -8px 0 16px; font-size: 0.9rem; }
	.phases { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 16px; }
	h3 { font-size: 0.95rem; margin: 0 0 6px; }
	ul { list-style: none; margin: 0; padding: 0; }
	li { display: flex; gap: 8px; align-items: baseline; margin-bottom: 4px; }
	.box {
		flex: none; width: 1em; height: 1em; border: 1.5px solid var(--muted); border-radius: 3px;
		display: inline-flex; align-items: center; justify-content: center; font-size: 0.75rem; line-height: 1;
	}
	li.done .box { background: var(--ok); border-color: var(--ok); color: var(--bg); }
	li.done { color: var(--muted); }
	.sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
</style>
